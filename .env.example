# Copie para .env.local e ajuste. Nunca commite valores reais.
# Todas as variáveis são server-side (nenhuma com prefixo NEXT_PUBLIC_).

# PostgreSQL (obrigatória). Local ou Supabase.
# Supabase em serverless (Vercel): use a connection string do pooler (porta 6543).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hub_fiel

# Chave da API-Football. Ainda não usada na Fase 0. Opcional por enquanto.
API_FOOTBALL_KEY=

# Segredo para autenticar chamadas de cron (mín. 16 caracteres).
# Ainda não usado na Fase 0. Opcional por enquanto.
CRON_SECRET=

# E-mail do administrador. Ainda não usado na Fase 0. Opcional por enquanto.
ADMIN_EMAIL=
